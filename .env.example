# Copier en .env (jamais versionné) puis adapter.

# Token Hugging Face (facultatif pour les modèles publics, requis pour les modèles privés)
HF_TOKEN=

# API
# dummy = tri simulé sans IA (front) ; probe = sonde CLIP (recommandé) ; dit = DiT non adapté
# (probe et dit : image construite avec WITH_ML=true, ou `uv sync --group ml` en local)
DOCROUTER_CLASSIFIER=dummy
DOCROUTER_PROBE_HEAD=models/probes/probe-clip.npz
DOCROUTER_MODEL_ID=microsoft/dit-base-finetuned-rvlcdip
DOCROUTER_CONFIDENCE_THRESHOLD=0.6
DOCROUTER_MAX_UPLOAD_MB=10

# Front (en local ; dans Docker, l'URL est fixée par docker-compose)
DOCROUTER_API_URL=http://localhost:8000
DOCROUTER_OUTPUT_DIR=output
